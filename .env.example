# Copy this file to ".env" (no .example) to change settings, then run stop.bat and start.bat.

# The open-source model Ollama runs. Good choices for an 8 GB graphics card:
#   qwen2.5:7b   (default, good at following structured instructions)
#   llama3.1:8b
OLLAMA_MODEL=qwen2.5:7b

# The port the app opens on: http://localhost:8080
APP_PORT=8080
